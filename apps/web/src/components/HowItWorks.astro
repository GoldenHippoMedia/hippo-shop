---
const steps = [
  {
    title: 'Drop the SDK script tag on your page',
    body: 'Add the script with your access key, your brand display name, and <code class="font-mono text-[13px]">data-brand-token</code> — the brand vocabulary funnel events are attributed by. The SDK boots automatically, attaches <code class="font-mono text-[13px]">window.gh</code>, and establishes the visitor session.',
  },
  {
    title: 'Bind the offer with <code class="font-mono text-[13px]">data-gh-destination</code>, the CTA with <code class="font-mono text-[13px]">data-gh-checkout</code>',
    body: 'One destination per offer. Inside it, bind the price and the offer name with <code class="font-mono text-[13px]">data-field</code> and <code class="font-mono text-[13px]">data-attr-*</code>, and put <code class="font-mono text-[13px]">data-gh-checkout</code> on the CTA itself — the SDK composes the outbound URL with the session id and the attribution params. On a funnel page, add <code class="font-mono text-[13px]">data-gh-step</code> so Page Views report the right step.',
  },
  {
    title: 'Marketing edits the destination, the page updates',
    body: 'Change a price or swap an order form in your destination data — the next pageview reflects it. No PR, no deploy, no engineering ticket.',
  },
];
---
<section class="bg-white px-8 py-16">
  <h2 class="font-display font-bold text-3xl text-center mb-2">How it works</h2>
  <p class="text-sm text-gh-ink-500 text-center mb-10 max-w-[540px] mx-auto">
    Three steps, no build tooling required.
  </p>

  <div class="max-w-[640px] mx-auto">
    {steps.map((step, i) => (
      <div class={`flex gap-4 py-4 items-start ${i === 0 ? '' : 'border-t border-gh-ink-100'}`}>
        <div class="bg-gh-yellow-500 text-gh-ink-900 w-8 h-8 rounded-full flex items-center justify-center font-bold text-sm flex-shrink-0">
          {i + 1}
        </div>
        <div>
          <h3 class="font-display font-semibold text-base mb-1">
            <Fragment set:html={step.title} />
          </h3>
          <p class="text-sm text-gh-ink-700">
            <Fragment set:html={step.body} />
          </p>
        </div>
      </div>
    ))}
  </div>
</section>
